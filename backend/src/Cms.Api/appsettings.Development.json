{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "CloudWatch": { 
      "Enabled": false 
    }
  },
  "Jwt": {
    "Key": "ThisIsADevelopmentKeyThatShouldBeAtLeast32CharactersLong!",
    "Issuer": "Cms",
    "Audience": "CmsUsers",
    "ExpirationMinutes": 480
  },
  "Proxy": {
    "AllowedHosts": [
      "httpbin.org",
      "jsonplaceholder.typicode.com"
    ],
    "BaseUrls": {
      "httpbin": "https://httpbin.org",
      "jsonplaceholder": "https://jsonplaceholder.typicode.com"
    },
    "Credentials": {
      "sampleBearer": {
        "Type": "bearer",
        "Token": "YOUR_TOKEN_HERE"
      },
      "sampleApiKey": {
        "Type": "api_key",
        "ApiKey": "YOUR_API_KEY_HERE",
        "ApiKeyHeader": "X-API-KEY"
      }
    },
    "DefaultTimeoutSeconds": 30,
    "MaxTimeoutSeconds": 60,
    "MaxResponseBytes": 1048576
  },
  "MosGateway": {
    "BaseUrl": "",
    "ClientId": "",
    "ClientSecret": "your-secure-secret-min-16-chars",
    "AllowedRedirectUris": [
      "http://localhost:3000/signin-callback",
      "https://localhost:3000/signin-callback"
    ],
    "UserInfoPath": "oauth/whoami",
    "TimeoutSeconds": 60
  }
}

