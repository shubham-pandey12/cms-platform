{
  "Logging": {
    "UseOpenTelemetryForLogs": false,
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "HealthChecks": {
    "EnablePublicEndpoints": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Formatting.Compact" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "CloudWatch": {
      "Enabled": true,
      "LogGroup": "/content-studio",
      "Region": "eu-west-2"
    },
    "Properties": {
      "Application": "Cms.Api"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "REPLACE_WITH_SECURE_KEY_IN_PRODUCTION_MIN_32_CHARS",
    "Issuer": "Cms",
    "Audience": "CmsUsers",
    "ExpirationMinutes": 60
  },
  "Media": {
    "PublicBaseUrl": "",
    "WebpQuality": 85
  },
  "MosGateway": {
    "BaseUrl": "",
    "ClientId": "",
    "ClientSecret": "",
    "AllowedRedirectUris": [],
    "UserInfoPath": "oauth/whoami",
    "TimeoutSeconds": 60
  }
}

