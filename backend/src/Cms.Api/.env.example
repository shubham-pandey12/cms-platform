# Cms API – local run (without Docker)
# Copy to .env and set values. Do not commit .env (it may contain secrets).
# The API uses the connection name "cmsdb" (AddNpgsqlDbContext in Persistence).
# Alternatively use User Secrets: dotnet user-secrets set "ConnectionStrings:cmsdb" "Host=...;Password=...;Database=cmsdb"

ConnectionStrings__cmsdb=Host=localhost;Port=5432;Username=postgres;Password=YOUR_PASSWORD;Database=cmsdb
