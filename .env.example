# =============================================================================
# CMS Docker - Full Configuration Template
# Copy to .env, .env.Development, .env.UAT, or .env.Production and set values.
# Do not commit files that contain real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# INFRASTRUCTURE
# -----------------------------------------------------------------------------
# API image name (used when running API in Docker)
CMS_API_IMAGE=cms-api:latest

# Port the API listens on (host port mapping)
CMS_API_PORT=8080

# -----------------------------------------------------------------------------
# POSTGRESQL (Development / Docker)
# -----------------------------------------------------------------------------
# PostgreSQL password (required for Docker postgres container)
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# CONNECTION STRINGS
# -----------------------------------------------------------------------------
# Database connection string
# Development (Docker): auto-generated from POSTGRES_PASSWORD
# UAT/Production: Use RDS endpoint, e.g.:
# Host=<rds-endpoint>;Port=5432;Username=<user>;Password=<pwd>;Database=cmsdb;SSL Mode=Require;
ConnectionStrings__cmsdb=

# -----------------------------------------------------------------------------
# ASP.NET CORE ENVIRONMENT
# -----------------------------------------------------------------------------
# Options: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Development

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# JWT signing key (required for UAT/Production; must be at least 32 characters)
Jwt__Key=
Jwt__Issuer=Cms
Jwt__Audience=CmsUsers
Jwt__ExpirationMinutes=60

# -----------------------------------------------------------------------------
# MOS GATEWAY (OAuth - "Sign in with MOS")
# -----------------------------------------------------------------------------
# Base URL of the MOS Gateway
MosGateway__BaseUrl=
# OAuth Client ID
MosGateway__ClientId=
# OAuth Client Secret (keep secure!)
MosGateway__ClientSecret=
# Allowed redirect URIs for OAuth callback
# Add more as needed: __0, __1, __2, etc.
MosGateway__AllowedRedirectUris__0=
MosGateway__AllowedRedirectUris__1=
# User info endpoint path (relative to BaseUrl)
MosGateway__UserInfoPath=oauth/whoami
# HTTP timeout in seconds (token exchange + whoami). Use 60 in UAT/prod if you see 408 timeouts.
MosGateway__TimeoutSeconds=60

# -----------------------------------------------------------------------------
# PROXY SETTINGS
# -----------------------------------------------------------------------------
# Allowed hosts for proxy requests (array)
Proxy__AllowedHosts__0=httpbin.org
Proxy__AllowedHosts__1=jsonplaceholder.typicode.com

# Base URLs for named proxies
Proxy__BaseUrls__httpbin=https://httpbin.org
Proxy__BaseUrls__jsonplaceholder=https://jsonplaceholder.typicode.com

# Bearer token credential example
Proxy__Credentials__sampleBearer__Type=bearer
Proxy__Credentials__sampleBearer__Token=

# API key credential example
Proxy__Credentials__sampleApiKey__Type=api_key
Proxy__Credentials__sampleApiKey__ApiKey=
Proxy__Credentials__sampleApiKey__ApiKeyHeader=X-API-KEY

# Timeout settings (in seconds)
Proxy__DefaultTimeoutSeconds=30
Proxy__MaxTimeoutSeconds=60

# Max response size in bytes (1MB default)
Proxy__MaxResponseBytes=1048576

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Log levels: Trace, Debug, Information, Warning, Error, Critical, None
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft__AspNetCore=Warning
Logging__LogLevel__Microsoft__EntityFrameworkCore=Warning

# -----------------------------------------------------------------------------
# FRONTEND (Build-time variables)
# -----------------------------------------------------------------------------
# API URL for browser requests (public, accessible from client)
NEXT_PUBLIC_API_BASE_URL=
# MOS Gateway URL for "Sign in with MOS" (public)
NEXT_PUBLIC_MOS_GATEWAY_URL=
# MOS Gateway Client ID for "Sign in with MOS" (public)
NEXT_PUBLIC_MOS_GATEWAY_CLIENT_ID=

# -----------------------------------------------------------------------------
# FRONTEND (Runtime variables)
# -----------------------------------------------------------------------------
# API URL for server-side requests (internal Docker network)
# Default: http://cms-api:8080/api
API_BASE_URL=

# Public origin used to build OAuth redirect_uri when running behind a reverse proxy or ALB.
# Must be scheme + host (no trailing slash, no path). Example: https://example.com
# Required when the ALB does not forward the external Host header to the Next.js container.
# Must match gateway redirectUris registration and MosGateway:AllowedRedirectUris on the backend.
# Leave blank for local development (origin is derived from the request automatically).
MOS_AUTH_PUBLIC_ORIGIN=https://example.com
