# API base URL (no trailing slash). Used by both browser and server.
# NEXT_PUBLIC_API_BASE_URL=https://localhost:5002/api

# MOS Gateway OAuth (optional). When set, "Sign in with MOS" is shown on the login page.
NEXT_PUBLIC_MOS_GATEWAY_URL=
NEXT_PUBLIC_MOS_GATEWAY_CLIENT_ID=

# ---------------------------------------------------------------------------
# Public-facing origin used to build OAuth redirect_uri (runtime, server-side).
# REQUIRED when running behind a reverse proxy or ALB that does not forward
# the external Host header (e.g. ECS, Kubernetes, docker-compose with a proxy).
# Must match the redirect URI registered with the OAuth provider AND the value
# in MosGateway:AllowedRedirectUris on the backend.
# Example: MOS_AUTH_PUBLIC_ORIGIN=https://cms.example.com
# When unset, origin is derived from x-forwarded-proto/host → host header → nextUrl.
# Never prefix this with NEXT_PUBLIC_ — it is server-only.
MOS_AUTH_PUBLIC_ORIGIN=

# Optional. When set, GET /api/embed/widget requires Authorization: Bearer <secret> or ?key=<secret>.
# EMBED_API_SECRET=

# Optional. Public origin of this Next app (no trailing slash). Used when copying HTML embed links in the
# page builder so production URLs are correct (defaults to window.location.origin when unset).
# NEXT_PUBLIC_APP_ORIGIN=https://your-cms-frontend.example.com
